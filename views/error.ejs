<%- include('partials/header', { profile: { name: 'Portfolio', github: '#', linkedin: '#' }, currentPath: '' }) %>

<section class="container py-5 text-center">
  <div class="error-code"><%= status %></div>
  <h1 class="h2 mb-2"><%= message %></h1>
  <p class="text-muted-soft">That page doesn't exist, or something went wrong on the server.</p>
  <% if (error && error.stack) { %>
    <pre class="text-start d-inline-block mt-3"><%= error.stack %></pre>
  <% } %>
  <div class="mt-4"><a href="/" class="btn btn-accent btn-lg"><i class="fa-solid fa-house me-2"></i>Back to Home</a></div>
</section>

<%- include('partials/footer', { profile: { name: 'Portfolio', github: '#', linkedin: '#' } }) %>
