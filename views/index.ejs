<%- include('partials/header') %>

<!-- Hero section -->
<section class="hero py-5">
  <div class="container">
    <div class="row align-items-center g-4">
      <div class="col-md-7">
        <p class="text-uppercase small hero-eyebrow mb-2">Hello, I'm</p>
        <h1 class="display-4 fw-bold"><%= profile.name %></h1>
        <h2 class="h4 text-accent mb-3"><%= profile.role %></h2>
        <p class="lead"><%= profile.tagline %></p>
        <div class="d-flex flex-wrap gap-2 mt-4">
          <a href="/projects" class="btn btn-accent btn-lg"><i class="fa-solid fa-folder-open me-2"></i>View Projects</a>
          <a href="/contact" class="btn btn-outline-light btn-lg"><i class="fa-solid fa-paper-plane me-2"></i>Get in Touch</a>
        </div>
      </div>
      <div class="col-md-5 text-center">
        <img src="/images/avatar.svg" alt="Profile illustration" class="hero-avatar img-fluid">
      </div>
    </div>
  </div>
</section>

<!-- Skills strip -->
<section class="container py-5">
  <h2 class="section-title text-center mb-4">What I Work With</h2>
  <div class="d-flex flex-wrap justify-content-center gap-2">
    <% profile.skills.forEach(function (skill) { %>
      <span class="badge skill-badge fs-6"><%= skill %></span>
    <% }); %>
  </div>
</section>

<!-- Featured projects -->
<section class="container pb-4">
  <h2 class="section-title text-center mb-4">Featured Projects</h2>
  <div class="row g-4">
    <% projects.forEach(function (p) { %>
      <div class="col-md-4">
        <div class="card project-card h-100">
          <div class="card-body">
            <i class="<%= p.icon %> project-icon mb-3"></i>
            <h3 class="h5 card-title"><%= p.title %></h3>
            <p class="card-text"><%= p.description %></p>
          </div>
        </div>
      </div>
    <% }); %>
  </div>
  <div class="text-center mt-4">
    <a href="/projects" class="btn btn-outline-accent">See all projects <i class="fa-solid fa-arrow-right ms-1"></i></a>
  </div>
</section>

<%- include('partials/footer') %>
