<%- include('partials/header') %>

<section class="container py-5">
  <h1 class="page-title mb-2"><span class="section-index">~/</span>projects</h1>
  <p class="text-muted-soft mb-4">Filter by technology to see what I have built with it.</p>

  <%
    // Build the list of unique tags from all projects for the filter buttons
    const allTags = [];
    projects.forEach(function (p) {
      p.tags.forEach(function (t) { if (allTags.indexOf(t) === -1) allTags.push(t); });
    });
  %>

  <!-- Filter buttons (handled in public/javascripts/main.js) -->
  <div class="filter-bar mb-4" role="group" aria-label="Filter projects by technology">
    <button type="button" class="filter-btn active" data-filter="all">All</button>
    <% allTags.forEach(function (t) { %>
      <button type="button" class="filter-btn" data-filter="<%= t.toLowerCase() %>"><%= t %></button>
    <% }); %>
  </div>

  <div class="row g-4" id="projectGrid">
    <% projects.forEach(function (p) { %>
      <div class="col-md-6 col-lg-4 project-item" data-tags="<%= p.tags.join(',').toLowerCase() %>">
        <%- include('partials/project-card', { p: p }) %>
      </div>
    <% }); %>
  </div>

  <p id="noResults" class="text-center text-muted-soft mt-4 d-none">No projects match this filter yet.</p>
</section>

<%- include('partials/footer') %>
