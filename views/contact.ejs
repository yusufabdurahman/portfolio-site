<%- include('partials/header') %>

<section class="container py-5">
  <h1 class="page-title mb-2"><span class="section-index">~/</span>contact<span class="text-accent">_me</span></h1>
  <p class="text-muted-soft mb-4"><i class="status-dot me-2"></i><%= profile.availability %></p>

  <div class="row g-4">
    <div class="col-lg-7">
      <div class="card info-card">
        <div class="card-body p-4">
          <% if (sent) { %>
            <div class="text-center py-4">
              <i class="fa-solid fa-circle-check success-icon mb-3"></i>
              <h2 class="h4">Message received!</h2>
              <p class="text-muted-soft">Thanks for reaching out. I'll get back to you soon.</p>
              <a href="/contact" class="btn btn-outline-accent">Send another</a>
            </div>
          <% } else { %>
            <% if (error) { %>
              <div class="alert alert-danger" role="alert"><i class="fa-solid fa-triangle-exclamation me-2"></i><%= error %></div>
            <% } %>
            <!-- The form POSTs to /contact, which is handled in routes/index.js -->
            <form action="/contact" method="POST" novalidate>
              <div class="mb-3">
                <label for="name" class="form-label">Name</label>
                <input type="text" class="form-control" id="name" name="name" value="<%= form.name || '' %>" required>
              </div>
              <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input type="email" class="form-control" id="email" name="email" value="<%= form.email || '' %>" required>
              </div>
              <div class="mb-3">
                <label for="message" class="form-label">Message</label>
                <textarea class="form-control" id="message" name="message" rows="5" required><%= form.message || '' %></textarea>
              </div>
              <button type="submit" class="btn btn-accent btn-lg"><i class="fa-solid fa-paper-plane me-2"></i>Send Message</button>
            </form>
          <% } %>
        </div>
      </div>
    </div>

    <div class="col-lg-5">
      <div class="contact-link reveal mb-3">
        <i class="fa-solid fa-envelope"></i>
        <div class="flex-grow-1">
          <div class="small text-muted-soft">Email</div>
          <a href="mailto:<%= profile.email %>" id="emailText"><%= profile.email %></a>
        </div>
        <!-- Copies the email address to the clipboard (see main.js) -->
        <button type="button" class="btn btn-sm btn-outline-accent" id="copyEmail" data-email="<%= profile.email %>">
          <i class="fa-regular fa-copy me-1"></i><span>Copy</span>
        </button>
      </div>
      <a class="contact-link reveal mb-3" href="<%= profile.github %>" target="_blank" rel="noopener">
        <i class="fa-brands fa-github"></i>
        <div><div class="small text-muted-soft">GitHub</div>See my code</div>
      </a>
      <a class="contact-link reveal mb-3" href="<%= profile.linkedin %>" target="_blank" rel="noopener">
        <i class="fa-brands fa-linkedin"></i>
        <div><div class="small text-muted-soft">LinkedIn</div>Let's connect</div>
      </a>
      <div class="contact-link reveal">
        <i class="fa-solid fa-location-dot"></i>
        <div><div class="small text-muted-soft">Based in</div><%= profile.location %></div>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
