<!-- Reusable project card. Expects a local variable "p" (one project). -->
<div class="card project-card h-100 reveal">
  <div class="card-body d-flex flex-column">
    <div class="d-flex justify-content-between align-items-start mb-3">
      <i class="<%= p.icon %> project-icon"></i>
      <span class="project-index">/ project</span>
    </div>
    <h3 class="h5 card-title"><%= p.title %></h3>
    <p class="card-text flex-grow-1"><%= p.description %></p>
    <div class="mb-3 d-flex flex-wrap gap-1">
      <% p.tags.forEach(function (t) { %>
        <span class="badge skill-badge"><%= t %></span>
      <% }); %>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <a href="<%= p.repo %>" target="_blank" rel="noopener" class="btn btn-outline-accent btn-sm">
        <i class="fa-brands fa-github me-1"></i>Code
      </a>
      <% if (p.demo) { %>
        <a href="<%= p.demo %>" target="_blank" rel="noopener" class="btn btn-accent btn-sm">
          <i class="fa-solid fa-arrow-up-right-from-square me-1"></i>Live demo
        </a>
      <% } %>
    </div>
  </div>
</div>
