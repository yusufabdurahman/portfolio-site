  </main>

  <!-- Shared footer: included on every page. Contains the required GitHub and LinkedIn links. -->
  <footer class="site-footer py-4 mt-5">
    <div class="container">
      <div class="row align-items-center gy-3">
        <div class="col-md-4 text-center text-md-start">
          <span class="brand-mark"><span class="brand-bracket">&lt;</span><%= profile.name %><span class="brand-bracket">/&gt;</span></span>
          <div class="small footer-note mt-1">&copy; <%= new Date().getFullYear() %> All rights reserved.</div>
        </div>
        <div class="col-md-4 text-center small footer-note">
          Built with <i class="fa-brands fa-node-js"></i> Node.js, Express &amp; EJS
        </div>
        <div class="col-md-4 text-center text-md-end footer-links">
          <a href="<%= profile.github %>" target="_blank" rel="noopener" aria-label="GitHub">
            <i class="fa-brands fa-github fa-lg me-1"></i>GitHub
          </a>
          <a href="<%= profile.linkedin %>" target="_blank" rel="noopener" aria-label="LinkedIn" class="ms-3">
            <i class="fa-brands fa-linkedin fa-lg me-1"></i>LinkedIn
          </a>
        </div>
      </div>
    </div>
  </footer>

  <!-- Back-to-top button (shown after scrolling, see main.js) -->
  <button type="button" id="toTop" class="to-top" aria-label="Back to top">
    <i class="fa-solid fa-arrow-up"></i>
  </button>

  <!-- Bootstrap JS bundle (needed for the mobile navbar toggle) -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <!-- My own script, served from public/javascripts -->
  <script src="/javascripts/main.js"></script>
</body>
</html>
